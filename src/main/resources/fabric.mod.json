{
    "schemaVersion": 1,
    "id": "${id}",
    "version": "${version}",

    "name": "${name}",
    "description": "Per-Player Phantom Spawning config tool",
    "authors": [
        "sakura-ryoko"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/phantom-spawning",
        "sources": "https://github.com/sakura-ryoko/phantom-spawning",
        "issues": "https://github.com/sakura-ryoko/phantom-spawning/issues"
    },

    "icon": "assets/phantom-spawning/icon.png",

    "environment": "*",
    "entrypoints": {
        "main": [
            "com.sakuraryoko.phantom_spawning.impl.PhantomSpawningMod"
        ]
    },
    "mixins": [
        "phantom-spawning.mixins.json"
    ],
    "accessWidener": "phantom-spawning.accesswidener",

    "depends": {
        "fabricloader": ">=0.11.4",
        "core-lib-api": "*",
        "minecraft": "${minecraft_dependency}"
    }
}
